# Mẫu cấu hình Nginx reverse proxy cho backend La Fiorentina.
# Copy nội dung này vào /etc/nginx/sites-available/api.lafiorentina.vn
# rồi tạo symlink: ln -s /etc/nginx/sites-available/api.lafiorentina.vn /etc/nginx/sites-enabled/
#
# Sau đó bật HTTPS miễn phí bằng Certbot:
#   sudo apt install certbot python3-certbot-nginx
#   sudo certbot --nginx -d api.lafiorentina.vn
# Certbot sẽ tự sửa file này để thêm cấu hình SSL, không cần tự thêm listen 443.

server {
    listen 80;
    server_name api.lafiorentina.vn;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
